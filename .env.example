# ==============================================================================
# Customer Feedback Intelligence Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides if needed.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL & PGVector Database Configuration (Phase 1+)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feedback_intel
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_intel

# ------------------------------------------------------------------------------
# 2. Spring Boot Business Backend Service (Phase 1+)
# ------------------------------------------------------------------------------
SPRING_BOOT_PORT=8080
SPRING_PROFILES_ACTIVE=dev
AI_SERVICE_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ------------------------------------------------------------------------------
# 3. Python FastAPI AI Service (Phase 1+)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
FASTAPI_HOST=0.0.0.0
FASTAPI_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 4. Angular Frontend Web Application (Phase 1+)
# ------------------------------------------------------------------------------
ANGULAR_PORT=4200
ANGULAR_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 5. Future AI / Model Provider Configuration
# [IMPORTANT]: NOT required, requested, or active in Phase 1.
# Integration with real model providers will occur in Phase 3+.
# ------------------------------------------------------------------------------
# MODEL_PROVIDER=azure_openai # Options: azure_openai, openai, local
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small
# OPENAI_API_KEY=your-openai-api-key-here
# CHAT_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small
# PROMPT_VERSION=v1.0
